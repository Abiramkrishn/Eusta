# Eusta Environment Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Hostinger MySQL / MariaDB)
# Options: 'mysql' for Hostinger production MySQL, or 'json' for zero-config file storage
DB_TYPE=json

# Hostinger MySQL Database Credentials (Required when DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=u123456789_eusta_user
DB_PASS=YourStrongPassword123!
DB_NAME=u123456789_eusta_db
DB_PORT=3306

# Secret key for JWT / Session handling
JWT_SECRET=eusta_super_secret_production_key_2026
